{
  "uid": "limna-oversikt",
  "title": "LIMNA — översikt",
  "tags": [
    "limna"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "boj",
        "label": "Boj",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "limna-influx"
        },
        "refresh": 1,
        "includeAll": true,
        "multi": false,
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"limna\", tag: \"boj\")"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Senaste värden",
      "datasource": {
        "type": "influxdb",
        "uid": "limna-influx"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "limna-influx"
          },
          "query": "from(bucket: \"limna\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"limna\")\n  |> filter(fn: (r) => r._field == \"ph\" or r._field == \"orp\" or r._field == \"turb\" or r._field == \"temp\" or r._field == \"batt\")\n  |> filter(fn: (r) => r.boj =~ /^${boj:regex}$/)\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "pH",
      "datasource": {
        "type": "influxdb",
        "uid": "limna-influx"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 6
              },
              {
                "color": "red",
                "value": 9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "limna-influx"
          },
          "query": "from(bucket: \"limna\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"limna\")\n  |> filter(fn: (r) => r._field == \"ph\")\n  |> filter(fn: (r) => r.boj =~ /^${boj:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "description": "Larmgräns F-10: utanför 6,0–9,0 i 15 minuter. PLACEHOLDER, sätts med bonden."
