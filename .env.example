# LIMNA - hemligheter for utvecklingsuppsattningen.
#
#   cp .env.example .env
#
# .env ar utesluten i .gitignore och ska ALDRIG committas. Denna fil, med
# platshallare i stallet for varden, ar den som ligger i versionshantering
# sa att nasta person vet vilka variabler som behovs.
#
# Docker Compose laser .env automatiskt ur samma mapp som
# docker-compose.yml. Telegraf och Grafana far varden vidareskickade som
# miljovariabler och expanderar dem i sina egna konfigurationsfiler, sa
# token finns nu pa ETT stalle i stallet for tre.
#
# VIKTIGT OM TOKEN: InfluxDB satter upp sig sjalv EN gang, forsta gangen
# containern startar, och sparar token i sin volym. Andrar du INFLUX_TOKEN
# harefter far telegraf och Grafana 401 mot en databas som fortfarande har
# den gamla. For att byta pa riktigt kravs:
#
#   docker compose down -v      <- raderar all matdata
#   docker compose up -d
#
# Varden nedan ar utvecklingsvarden. De ar inte hemliga och ska inte vara
# det -- allt kor pa localhost. For pilot galler avsnittet om K-02 i README.

# InfluxDB
INFLUX_USERNAME=limna
INFLUX_PASSWORD=byt-mig
INFLUX_ORG=hydrovault
INFLUX_BUCKET=limna
INFLUX_TOKEN=byt-mig-till-en-lang-slumpstrang

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=byt-mig

# MQTT. Tomma i utvecklingsuppsattningen: brokern ar oautentiserad med
# avsikt. Pollaren laser dessa namn ur config.json (username_env och
# password_env) och hoppar over inloggning nar de inte ar satta.
LIMNA_MQTT_USER=
LIMNA_MQTT_PASS=
